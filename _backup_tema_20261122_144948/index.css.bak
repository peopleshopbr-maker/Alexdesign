@import "tailwindcss";

:root,
:root[data-theme="beige"] {
  --bg-canvas: #f5f1ea;
  --bg-surface: #eae3d5;
  --bg-elevated: #fdfbf7;
  --border-subtle: #d6cbb8;
  --text-primary: #2c2621;
  --text-secondary: #6e6356;
  --accent-primary: #b86b35;
  --accent-hover: #9e5827;
  --accent-soft: rgba(184, 107, 53, 0.14);
}

:root[data-theme="dark"] {
  --bg-canvas: #090b10;
  --bg-surface: #0f131b;
  --bg-elevated: #161b26;
  --border-subtle: #1e293b;
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --accent-primary: #ea580c;
  --accent-hover: #f97316;
  --accent-soft: rgba(249, 115, 22, 0.15);
}

@layer base {
  html,
  body,
  #root {
    width: 100%;
    height: 100dvh;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    letter-spacing: 0.01em;
    -webkit-font-smoothing: antialiased;
    touch-action: manipulation;
  }

  button,
  a,
  input,
  select,
  textarea {
    transition: background-color 200ms cubic-bezier(0.22, 1, 0.36, 1),
                border-color 200ms cubic-bezier(0.22, 1, 0.36, 1),
                color 200ms cubic-bezier(0.22, 1, 0.36, 1),
                transform 140ms ease;
  }

  button:active:not(:disabled) {
    transform: scale(0.97);
  }
}

/* Mapeamento dinâmico de superfícies */
.bg-\[\#090b10\],
.bg-\[\#0D1017\],
.bg-\[\#0F131B\],
.bg-slate-950,
.bg-zinc-950 {
  background-color: var(--bg-canvas) !important;
  color: var(--text-primary) !important;
}

.bg-slate-900,
.bg-slate-900\/90,
.bg-slate-900\/80,
.bg-zinc-900 {
  background-color: var(--bg-surface) !important;
  backdrop-filter: blur(12px);
  color: var(--text-primary) !important;
}

.bg-slate-800,
.bg-slate-800\/80,
.bg-zinc-800 {
  background-color: var(--bg-elevated) !important;
  color: var(--text-primary) !important;
}

.border-slate-800,
.border-slate-800\/90,
.border-slate-700,
.border-zinc-800 {
  border-color: var(--border-subtle) !important;
}

.text-white,
.text-slate-100,
.text-slate-200 {
  color: var(--text-primary) !important;
}

.text-slate-300,
.text-slate-400,
.text-slate-500 {
  color: var(--text-secondary) !important;
}

.bg-orange-600,
.bg-orange-500 {
  background-color: var(--accent-primary) !important;
  color: #fdfbf7 !important;
}

.bg-orange-600:hover,
.bg-orange-500:hover {
  background-color: var(--accent-hover) !important;
}

.bg-orange-600 span,
.bg-orange-500 span,
.bg-orange-600 svg,
.bg-orange-500 svg {
  color: #fdfbf7 !important;
}

.text-orange-400,
.text-orange-500 {
  color: var(--accent-primary) !important;
}

.bg-orange-500\/10 {
  background-color: var(--accent-soft) !important;
}

/* Modo Foco (Zen Mode): oculta barras e docks para visualização 3D limpa */
html[data-zen="true"] header,
html[data-zen="true"] nav,
html[data-zen="true"] section.border-t {
  display: none !important;
}

.no-scrollbar::-webkit-scrollbar {
  display: none;
}
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.pb-safe {
  padding-bottom: env(safe-area-inset-bottom, 0px);
}

::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgba(158, 138, 114, 0.45);
  border-radius: 9999px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--accent-primary);
}
