{
  "name": "renderalexdesign-site",
  "private": true,
  "version": "1.0.0",
  "description": "Site do estudio RenderAlex Design: HTML + CSS + TypeScript + Python + Cloudflare D1",
  "scripts": {
    "build": "tsc -p tsconfig.site.json && tsc -p tsconfig.worker.json",
    "check": "tsc --noEmit -p tsconfig.site.json && tsc --noEmit -p tsconfig.worker.json",
    "watch": "tsc -w -p tsconfig.site.json",
    "site": "python build_site.py",
    "gerar": "npm run build && python build_site.py",
    "db:schema": "wrangler d1 execute renderalex-site --local --file=./db/schema.sql",
    "db:seed": "wrangler d1 execute renderalex-site --local --file=./db/seed.sql",
    "db:remote": "wrangler d1 execute renderalex-site --remote --file=./db/schema.sql",
    "dev": "wrangler pages dev public --d1 DB=renderalex-site"
  },
  "devDependencies": {
    "three": "^0.186.1",
    "typescript": "^7.0.2"
  }
}
